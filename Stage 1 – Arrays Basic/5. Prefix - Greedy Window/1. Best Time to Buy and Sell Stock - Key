Input : Array
Keywords : Maximize profit => Greedy
Constraints : 1 <= prices.length <= 10 ^ 5 => O(n log n), O(n)

//Bruteforce - Try every possible pair of days (i, j) where j > i. 
                Buy on day i, sell on day j. 
                Track the maximum profit from all valid pairs.
//TC = O(n^2)
//SC = O(1)
class Solution {
    public int maxProfit(int[] prices) {
        int maxProfit = 0;
        int n = prices.length;

        for(int i = 0; i < n; i++){
            for(int j = i+1; j < n; j++){
                int profit = prices[j] - prices[i];  // Buy on day i, sell on day j. 
                maxProfit = Math.max(maxProfit, profit);
            }
        }
        return maxProfit;
    }
}

//Optimal : 
  // Imagine you're tracking the lowest price you've seen so far
  // At each day, you ask: "if I sell TODAY, what's my profit?"
  // profit = today's price - lowest price seen before today

//TC = O(n) 
//SC = O(1)
class Solution {
    public int maxProfit(int[] prices) {
        int maxProfit = 0;
        int minPrice = Integer.MAX_VALUE;
        for(int price : prices){
            minPrice = Math.min(price, minPrice); // Update minPrice if we find a lower price
            int profitToday = price - minPrice;// Calculate potential profit today
            maxProfit = Math.max(profitToday, maxProfit);//Calculate maxProfit
        }
        return maxProfit;
    }
}
